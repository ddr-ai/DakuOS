# Firmware available on the live image for hardware detection.
# Only packages that currently exist in Debian Testing (Forky) non-free-firmware.
# Hardware-aware install (udev / hw-detect) still decides what ends up on disk.

# Core free + non-free firmware meta packages
firmware-linux-free
firmware-linux-nonfree
firmware-misc-nonfree

# Common wireless / network
firmware-iwlwifi
firmware-realtek
firmware-atheros
firmware-brcm80211
firmware-libertas
firmware-ti-connectivity

# Graphics
firmware-amd-graphics

# Storage / niche NICs still useful on servers and older hardware
firmware-bnx2
firmware-bnx2x
firmware-qlogic
firmware-netxen
