# DakuOS default desktop – KDE Plasma (Debian Testing / Forky)
#
# task-kde-desktop pulls the current Plasma stack and its hard dependencies.
# Extra lines below are packages we want explicitly, using Testing names only.

task-kde-desktop

# Display manager
sddm
kde-config-sddm

# Network (Plasma-native + NetworkManager)
plasma-nm
network-manager

# Audio – PipeWire is the default on modern Debian/KDE (not PulseAudio)
pipewire
pipewire-pulse
pipewire-alsa
wireplumber
libspa-0.2-bluetooth
pavucontrol-qt

# Bluetooth
bluez
bluedevil
