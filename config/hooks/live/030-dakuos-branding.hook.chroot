#!/bin/sh
set -e

echo "DakuOS: installing custom branding (logo, Plymouth, SDDM, GRUB)..."

BRAND=/usr/share/dakuos/branding
mkdir -p "$BRAND"
mkdir -p /usr/share/plymouth/themes/dakuos
mkdir -p /usr/share/sddm/themes/dakuos
mkdir -p /boot/grub
mkdir -p /usr/share/images/desktop-base
mkdir -p /usr/share/wallpapers/DakuOS/contents/images
mkdir -p /etc/sddm.conf.d
mkdir -p /usr/share/sddm/themes/breeze

# Decode base64 without aborting the whole hook on bad input (set -e).
# Returns 0 only if the output file is non-empty after a successful decode.
b64_decode() {
  # $1 = input .b64 path, $2 = output path
  _in="$1"
  _out="$2"
  _tmp="${_out}.tmp"
  if tr -d ' \n\r\t' < "$_in" | base64 -d > "$_tmp" 2>/dev/null \
    && [ -s "$_tmp" ]; then
    mv -f "$_tmp" "$_out"
    return 0
  fi
  rm -f "$_tmp"
  return 1
}

# Prefer a real image already in includes.chroot under any common name.
if [ ! -f "$BRAND/logo-boot.jpg" ]; then
  for cand in \
    "$BRAND/boot-logo.jpeg" \
    "$BRAND/boot-logo.jpg" \
    "$BRAND/logo-boot.jpeg" \
    "$BRAND/logo-boot.png" \
    "$BRAND/boot-logo.png"
  do
    if [ -f "$cand" ]; then
      cp -f "$cand" "$BRAND/logo-boot.jpg"
      echo "  using $(basename "$cand") as logo-boot.jpg"
      break
    fi
  done
fi

# Else assemble/decode base64 parts (tolerant of invalid padding).
if [ ! -f "$BRAND/logo-boot.jpg" ]; then
  if ls "$BRAND"/logo-boot.jpg.b64.part* >/dev/null 2>&1; then
    cat "$BRAND"/logo-boot.jpg.b64.part* > "$BRAND/logo-boot.jpg.b64.assembled"
    if b64_decode "$BRAND/logo-boot.jpg.b64.assembled" "$BRAND/logo-boot.jpg"; then
      echo "  assembled logo-boot.jpg from parts"
    else
      echo "  warning: failed to decode logo-boot.jpg.b64.part* (skipped)"
    fi
    rm -f "$BRAND/logo-boot.jpg.b64.assembled"
  elif [ -f "$BRAND/logo-boot.jpg.b64" ]; then
    if b64_decode "$BRAND/logo-boot.jpg.b64" "$BRAND/logo-boot.jpg"; then
      echo "  decoded logo-boot.jpg"
    else
      echo "  warning: failed to decode logo-boot.jpg.b64 (skipped)"
    fi
  fi
fi

if [ -f "$BRAND/logo-icon.jpg.b64" ] && [ ! -f "$BRAND/logo-icon.jpg" ]; then
  if b64_decode "$BRAND/logo-icon.jpg.b64" "$BRAND/logo-icon.jpg"; then
    echo "  decoded logo-icon.jpg"
  else
    echo "  warning: failed to decode logo-icon.jpg.b64 (skipped)"
  fi
fi

# Fallback: use icon for boot surfaces if full splash is missing
if [ ! -f "$BRAND/logo-boot.jpg" ] && [ -f "$BRAND/logo-icon.jpg" ]; then
  cp -f "$BRAND/logo-icon.jpg" "$BRAND/logo-boot.jpg"
  echo "  using logo-icon.jpg as boot splash fallback"
fi

if [ -f "$BRAND/logo-boot.jpg" ]; then
  cp -f "$BRAND/logo-boot.jpg" "$BRAND/logo.jpg"
  cp -f "$BRAND/logo-boot.jpg" "$BRAND/logo-login.jpg"
  cp -f "$BRAND/logo-boot.jpg" "$BRAND/logo-grub.jpg"

  # Plymouth
  cp -f "$BRAND/logo-boot.jpg" /usr/share/plymouth/themes/dakuos/logo.jpg
  cat > /usr/share/plymouth/themes/dakuos/dakuos.plymouth << 'EOF'
[Plymouth Theme]
Name=DakuOS
Description=DakuOS fiery logo splash
ModuleName=script

[script]
ImageDir=/usr/share/plymouth/themes/dakuos
ScriptFile=/usr/share/plymouth/themes/dakuos/dakuos.script
EOF
  cat > /usr/share/plymouth/themes/dakuos/dakuos.script << 'EOF'
wallpaper_image = Image("logo.jpg");
screen_width = Window.GetWidth();
screen_height = Window.GetHeight();
max_w = screen_width * 0.6;
max_h = screen_height * 0.5;
scale = Math.Min(max_w / wallpaper_image.GetWidth(), max_h / wallpaper_image.GetHeight());
scaled = wallpaper_image.Scale(wallpaper_image.GetWidth() * scale, wallpaper_image.GetHeight() * scale);
logo_sprite = Sprite(scaled);
logo_sprite.SetX((screen_width - scaled.GetWidth()) / 2);
logo_sprite.SetY((screen_height - scaled.GetHeight()) / 2 - 40);
fun progress_callback(duration, progress) {
}
Plymouth.SetProgressFunction(progress_callback);
EOF
  if command -v plymouth-set-default-theme >/dev/null 2>&1; then
    plymouth-set-default-theme -R dakuos 2>/dev/null || plymouth-set-default-theme dakuos 2>/dev/null || true
  fi
  echo "  Plymouth theme: dakuos"

  # SDDM
  cp -f "$BRAND/logo-login.jpg" /usr/share/sddm/themes/dakuos/background.jpg
  cp -f "$BRAND/logo-login.jpg" /usr/share/sddm/themes/breeze/dakuos-background.jpg 2>/dev/null || true
  cat > /etc/sddm.conf.d/10-dakuos.conf << 'EOF'
[Theme]
Current=breeze
CursorTheme=breeze_cursors
EOF
  echo "  SDDM background installed"

  # GRUB
  cp -f "$BRAND/logo-grub.jpg" /boot/grub/dakuos-background.jpg
  cp -f "$BRAND/logo-grub.jpg" /usr/share/images/desktop-base/desktop-grub.jpg 2>/dev/null || true
  if [ -f /etc/default/grub ]; then
    if grep -q '^GRUB_BACKGROUND=' /etc/default/grub; then
      sed -i 's|^GRUB_BACKGROUND=.*|GRUB_BACKGROUND=/boot/grub/dakuos-background.jpg|' /etc/default/grub
    else
      echo 'GRUB_BACKGROUND=/boot/grub/dakuos-background.jpg' >> /etc/default/grub
    fi
    sed -i 's/^GRUB_DISTRIBUTOR=.*/GRUB_DISTRIBUTOR=DakuOS/' /etc/default/grub || true
  fi
  echo "  GRUB background set"

  # Wallpaper
  cp -f "$BRAND/logo-boot.jpg" /usr/share/wallpapers/DakuOS/contents/images/1920x1080.jpg
  cat > /usr/share/wallpapers/DakuOS/metadata.json << 'EOF'
{
  "KPlugin": {
    "Authors": [ { "Name": "DakuOS" } ],
    "Id": "DakuOS",
    "Name": "DakuOS",
    "License": "Proprietary"
  }
}
EOF
else
  echo "  warning: no logo-boot image found; branding assets skipped"
fi

echo "DakuOS: branding install finished."
